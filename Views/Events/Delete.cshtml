@model Event
@{ ViewData["Title"] = "Delete Event"; }
<div class="form-panel"><h1 class="h2 text-danger fw-bold">Delete event?</h1><p>Are you sure you want to delete <strong>@Model.Title</strong>? Its registrations will also be deleted.</p>
<form asp-action="Delete" method="post"><input type="hidden" asp-for="Id" /><button class="btn btn-danger">Yes, delete</button> <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a></form></div>
