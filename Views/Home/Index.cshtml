@model IEnumerable<Event>
@{
    ViewData["Title"] = "Home";
}
<section class="hero p-4 p-md-5 mb-4 rounded-4">
  <span class="eyebrow">YOUR CAMPUS. YOUR COMMUNITY.</span>
  <h1 class="display-5 fw-bold mt-2">Make campus moments <span>memorable.</span></h1>
  <p class="lead mt-3">Discover workshops, cultural festivals, competitions and more — all in one place.</p>
  <a asp-controller="Events" asp-action="Index" class="btn btn-light btn-lg mt-2">Explore Events</a>
</section>
<div class="row g-3 mb-4">
  <div class="col-md-6"><div class="stat-card"><div class="stat-number">@ViewBag.EventCount</div><div>Events listed</div></div></div>
  <div class="col-md-6"><div class="stat-card"><div class="stat-number">@ViewBag.RegistrationCount</div><div>Student registrations</div></div></div>
</div>
<div class="d-flex justify-content-between align-items-center mb-3">
  <h2 class="h3 fw-bold">Upcoming events</h2>
  <a asp-controller="Events" asp-action="Create" class="btn btn-primary">+ Add Event</a>
</div>
<div class="row g-3">
@foreach (var ev in Model)
{
  <div class="col-md-6 col-lg-4">
    <div class="event-card h-100">
      <div class="event-date">@ev.EventDate.ToString("dd MMM yyyy")</div>
      <span class="category">@ev.Category</span>
      <h3 class="h5 mt-3">@ev.Title</h3>
      <p class="muted">@ev.Description</p>
      <p class="small mb-3">📍 @ev.Venue</p>
      <a asp-controller="Registrations" asp-action="Create" asp-route-eventId="@ev.Id" class="btn btn-primary w-100">Register now</a>
    </div>
  </div>
}
@if (!Model.Any()) { <div class="col-12"><div class="empty-state">No events yet. Add your first event to get started.</div></div> }
</div>
